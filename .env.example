# Copy to .env (git-ignored) and fill in the passwords; README.md → Database
# creates the roles. Real environment variables win over this file.

# What the server connects as: reads and writes rows, never the schema.
AK_DATABASE_URL=postgres://riic_app:CHANGE-ME@localhost/riic
# What `ak-api migrate` connects as: owns the schema.
AK_MIGRATE_DATABASE_URL=postgres://riic_owner:CHANGE-ME@localhost/riic
# What the tests connect as, to create and drop a database per test.
DATABASE_URL=postgres://riic_test:CHANGE-ME@localhost/riic_test
